# Copy to `.env` (git-ignored). Nx loads this file for every task.

# --- @platform/api (NestJS) ---
PORT=3333
HOST=0.0.0.0
# Comma-separated list. Leave empty to disable CORS (the Next proxy makes it
# unnecessary in development).
CORS_ORIGIN=

# --- @platform/web (Next.js) ---
# Server-side target of the /backend/* rewrite in apps/web/next.config.js.
API_URL=http://localhost:3333
